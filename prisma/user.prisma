enum ROLES {
  USER
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String  @unique
  isBanned Boolean @default(false)
  role     ROLES   @default(USER)

  createdAt DateTime @default(now())

  toDoLists ToDoList[]
  sessions  Session[]
  pet       Pet?
  note      Note?
}
